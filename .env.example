# Copy to .env (never commit .env). The server imports it on startup (spring.config.import).

# Browser origins allowed to open the game WebSocket.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Supabase (Project Settings → API / Database).
SUPABASE_URL=https://<project-ref>.supabase.co
# Admin connection (session pooler) — only for applying migrations; the game server never uses it.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Game server DB access with the limited role from supabase/migrations/*_server_role.sql.
# Leave DB_URL empty to run without persistence.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=ascape_server.<project-ref>
DB_PASSWORD=<password set with: alter role ascape_server with password '...'>

# Allow connections without a Supabase token (named guest-xxxx). Handy for local dev and load tests; keep false in production.
AUTH_ALLOW_UNAUTHENTICATED=false

# Client-side (Vite exposes only VITE_* variables; the publishable key is safe in the browser).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
